# Dhan Gola - environment (requirement_v2 section 20). Copy to .env.local (never commit real values).
# One deployment per client: each client has its own Atlas project + these values.

MONGODB_URI=            # per client, e.g. mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/
MONGODB_DB=dhangola
AUTH_JWT_SECRET=        # 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_REFRESH_SECRET=    # 32+ random bytes, different from AUTH_JWT_SECRET
CRON_SECRET=            # random; the same value goes into GitHub secret CRON_SECRET_<CLIENT>
VAPID_PUBLIC_KEY=       # node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com
NEXT_PUBLIC_APP_NAME=Dhan Gola
NEXT_PUBLIC_CLIENT_SLUG=client-a
TZ=Asia/Kolkata
# Owner registration: auto = open until the first owner registers (default), true = always open
# (developer reopens it), false = always closed.
ALLOW_REGISTRATION=auto

# Optional
# AUTH_ACCESS_TTL_SEC=900     # access token lifetime (default 15 min)
# AUTH_COOKIE_INSECURE=1      # ONLY for local http testing on a non-localhost host
